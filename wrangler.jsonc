{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "nectr",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-10-01",

  // Served at nectr.<account>.workers.dev; per-version preview URLs stay off
  // so there is no extra hostname outside the Access application.
  "workers_dev": true,
  "preview_urls": false,

  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Everything else (SPA, JS, CSS) is served straight from assets.
    "run_worker_first": ["/api/*", "/s/*"]
  },

  "observability": { "enabled": true },

  // Fill these in with your own values (docs/setup.md).
  // Created once with `wrangler d1 create nectr` and `wrangler r2 bucket create nectr-audio`.
  "d1_databases": [{ "binding": "DB", "database_name": "nectr", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "nectr-audio" }],

  // Password attempts per IP + link (Workers Rate Limiting, free; period must be 10 or 60 s).
  // Comments and guest names: 10 per minute per IP + link.
  "ratelimits": [
    { "name": "UNLOCK_LIMITER", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } },
    { "name": "COMMENT_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],

  // Daily clean-up: abandoned uploads (>24 h pending) and soft-deleted items (>7 days).
  "triggers": { "crons": ["17 3 * * *"] },

  "vars": {
    "ENVIRONMENT": "production",
    // Not secret: Access JWTs are verified against the team's public keys.
    "OWNER_EMAIL": "you@example.com",
    "ACCESS_TEAM_DOMAIN": "",
    "ACCESS_AUD": "",
    // Presigned uploads go to https://<ACCOUNT_ID>.r2.cloudflarestorage.com/<R2_BUCKET>/…
    // Secrets (wrangler secret put): R2_ACCESS_KEY_ID, R2_SECRET_ACCESS_KEY, COOKIE_SECRET.
    "ACCOUNT_ID": "",
    "R2_BUCKET": "nectr-audio"
  }
}
