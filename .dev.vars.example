# Copy to .dev.vars for local development (never commit .dev.vars).
# In development on localhost, getOwner() accepts OWNER_EMAIL without Access.
ENVIRONMENT=development
OWNER_EMAIL=owner@example.com
# Signs the share-link password cookie. Any long random string works locally.
COOKIE_SECRET=dev-only-cookie-secret-change-me
# Not needed locally: uploads go through /api/admin/dev-upload instead of a presigned R2 URL.
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
