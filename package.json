{
  "name": "nectr",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types --strict-vars=false",
    "check": "svelte-check --tsconfig ./tsconfig.web.json && tsc -p tsconfig.worker.json --noEmit && tsc -p test/tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run --project unit --project worker",
    "loudness": "vitest run --project loudness --reporter=verbose",
    "test:watch": "vitest --project unit --project worker",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "aws4fetch": "^1.0.20",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "mpg123-decoder": "^1.0.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.2",
    "@cloudflare/vitest-plugin": "^1.4.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^24.19.2",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "~4.1.11",
    "wrangler": "^4.150.0"
  }
}
